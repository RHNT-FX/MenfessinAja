# PORT & ENVIRONMENT
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# SUPABASE CONFIGURATION (PostgreSQL & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=posts-media

# JWT AUTHENTICATION
JWT_SECRET=super-secret-jwt-key-menfessin-aja-2026
JWT_EXPIRES_IN=7d

# CLOUDFLARE TURNSTILE (Anti-Bot Human Challenge)
# For local testing, Cloudflare provides dummy keys:
# Site Key 1x00000000000000000000AA (always passes)
# Secret Key 1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MIDTRANS PAYMENT GATEWAY (Snap QRIS)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# JUAN ROUTER AI SERVICE (NLP Text Moderation & Computer Vision)
JUAN_ROUTER_API_KEY=your-juan-router-api-key
JUAN_ROUTER_BASE_URL=https://api.juanrouter.com/v1
JUAN_ROUTER_TEXT_MODEL=llm-text-moderator
JUAN_ROUTER_VISION_MODEL=cv-prohibited-detector
