{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "hono"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/assets/(.*)",
      "destination": { "service": "web" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web", "path": "/index.html" }
    }
  ]
}
